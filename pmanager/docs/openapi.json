{
  "openapi": "3.1.2",
  "info": {
    "title": "Provision Manager API",
    "description": "API for managing Orchestrations, Orchestration Definitions, and Activity Definitions",
    "version": "0.0.1"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Development server"
    }
  ],
  "paths": {
    "/api/v1alpha1/activity-definitions": {
      "get": {
        "tags": [
          "ActivityDefinition"
        ],
        "summary": "Get Activity Definitions",
        "description": "Returns all Activity Definitions",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/V1alpha1ActivityDefinitionDto"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "ActivityDefinition"
        ],
        "summary": "Create an Activity Definition",
        "description": "Create a new Activity Definition",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/V1alpha1ActivityDefinitionDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      }
    },
    "/api/v1alpha1/activity-definitions/{type}": {
      "delete": {
        "tags": [
          "ActivityDefinition"
        ],
        "summary": "Delete an Activity Definition",
        "description": "Delete a new Activity Definition",
        "parameters": [
          {
            "name": "type",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1alpha1/orchestration-definitions": {
      "get": {
        "tags": [
          "OrchestrationDefinition"
        ],
        "summary": "Get Orchestration Definitions",
        "description": "Returns all Orchestration Definitions",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/V1alpha1OrchestrationTemplate"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "OrchestrationDefinition"
        ],
        "summary": "Create Orchestration Definition(s) from an OrchestrationTemplate",
        "description": "Create Orchestration Definition(s) from an OrchestrationTemplate. The `id` field of the response contains a unique identifier (_template ID_ or _template-ref_), by which the generated Orchestration Definitions are referenced.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/V1alpha1OrchestrationTemplate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V1alpha1IDResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1alpha1/orchestration-definitions/{templateRef}": {
      "get": {
        "tags": [
          "OrchestrationDefinition"
        ],
        "summary": "Get all Orchestration Definitions by template ID",
        "description": "Get all Orchestration Definitions that were generated based on the given template ID",
        "parameters": [
          {
            "name": "templateRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/V1alpha1OrchestrationDefinitionDto"
                  }
                }
              }
            }
          },
          "404": {
            "description": "No OrchestrationDefinition with the given `templateRef` was found"
          }
        }
      },
      "delete": {
        "tags": [
          "OrchestrationDefinition"
        ],
        "summary": "Delete all Orchestration Definitions for the given template ID",
        "description": "Delete all Orchestration Definitions that were generated based on the given template ID",
        "parameters": [
          {
            "name": "templateRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "No OrchestrationDefinition with the given `templateRef` was found"
          }
        }
      }
    },
    "/api/v1alpha1/orchestrations": {
      "post": {
        "tags": [
          "Orchestration"
        ],
        "summary": "Execute an Orchestration",
        "description": "Execute an Orchestration",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ModelOrchestrationManifest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted"
          }
        }
      }
    },
    "/api/v1alpha1/orchestrations/query": {
      "post": {
        "tags": [
          "Orchestration"
        ],
        "summary": "Perform an Orchestration query",
        "description": "Perform an Orchestration query",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ModelQuery"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/V1alpha1OrchestrationEntry"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1alpha1/orchestrations/{id}": {
      "get": {
        "tags": [
          "Orchestration"
        ],
        "summary": "Get an Orchestration",
        "description": "Retrieve an Orchestration by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V1alpha1Orchestration"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ModelOrchestrationManifest": {
        "type": "object",
        "required": [
          "id",
          "correlationId",
          "orchestrationType"
        ],
        "properties": {
          "correlationId": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "orchestrationType": {
            "type": "string"
          },
          "payload": {
            "type": "object",
            "additionalProperties": {}
          }
        }
      },
      "ModelQuery": {
        "type": "object",
        "required": [
          "predicate"
        ],
        "properties": {
          "limit": {
            "type": "integer",
            "format": "int64"
          },
          "offset": {
            "type": "integer",
            "format": "int64"
          },
          "predicate": {
            "type": "string"
          }
        }
      },
      "V1alpha1ActivityDefinitionDto": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "inputSchema": {
            "type": "object",
            "additionalProperties": {}
          },
          "outputSchema": {
            "type": "object",
            "additionalProperties": {}
          },
          "type": {
            "type": "string"
          }
        }
      },
      "V1alpha1ActivityDto": {
        "type": "object",
        "required": [
          "id",
          "type"
        ],
        "properties": {
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      },
      "V1alpha1IDResponse": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        }
      },
      "V1alpha1Orchestration": {
        "type": "object",
        "properties": {
          "completed": {
            "type": "object",
            "additionalProperties": {
              "type": "object"
            }
          },
          "correlationId": {
            "type": "string"
          },
          "createdTimestamp": {
            "type": "string",
            "format": "date-time"
          },
          "definitionId": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "orchestrationType": {
            "type": "string"
          },
          "outputData": {
            "type": "object",
            "additionalProperties": {}
          },
          "processingData": {
            "type": "object",
            "additionalProperties": {}
          },
          "state": {
            "type": "integer",
            "format": "int32"
          },
          "stateTimestamp": {
            "type": "string",
            "format": "date-time"
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/V1alpha1OrchestrationStep"
            }
          }
        }
      },
      "V1alpha1OrchestrationDefinitionDto": {
        "type": "object",
        "required": [
          "activities",
          "templateRef"
        ],
        "properties": {
          "activities": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/V1alpha1ActivityDto"
              }
            }
          },
          "description": {
            "type": "string"
          },
          "schema": {
            "type": "object",
            "additionalProperties": {}
          },
          "templateRef": {
            "type": "string"
          }
        }
      },
      "V1alpha1OrchestrationEntry": {
        "type": "object",
        "properties": {
          "correlationId": {
            "type": "string"
          },
          "createdTimestamp": {
            "type": "string",
            "format": "date-time"
          },
          "definitionId": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "orchestrationType": {
            "type": "string"
          },
          "state": {
            "type": "integer",
            "format": "int32"
          },
          "stateTimestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "V1alpha1OrchestrationStep": {
        "type": "object",
        "properties": {
          "activities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/V1alpha1ActivityDto"
            }
          }
        }
      },
      "V1alpha1OrchestrationTemplate": {
        "type": "object",
        "required": [
          "activities"
        ],
        "properties": {
          "activities": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/V1alpha1ActivityDto"
              }
            }
          },
          "description": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "schema": {
            "type": "object",
            "additionalProperties": {}
          }
        }
      }
    }
  }
}
